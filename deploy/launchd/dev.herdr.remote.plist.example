<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.herdr.remote</string>
  <key>ProgramArguments</key><array>
    <string>/ABSOLUTE/PATH/herdr-remote</string><string>serve</string>
    <string>--state</string><string>/ABSOLUTE/PATH/private-host-state</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>/ABSOLUTE/PATH/private-host-state/service.log</string>
  <key>StandardErrorPath</key><string>/ABSOLUTE/PATH/private-host-state/service-error.log</string>
</dict></plist>
